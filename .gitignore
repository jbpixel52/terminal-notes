# build output
dist/
.astro/

# dependencies
node_modules/

# research scratch (raw session mining, pre-anonymisation)
.research/

# source photographs for the ascii art (see tools/make-art.py); only the
# generated modules in src/art/ are published
.art-src/

# the private term list is machine-local on purpose: a committed denylist
# would publish the names it is meant to protect
.private-terms

# verification output (screenshots + logs)
.verify/
.verify-run.log

# python bytecode: the art generator is imported by its own test, which writes
# __pycache__ next to it
__pycache__/
*.pyc

# logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# environment
.env
.env.production
.env.local

# editor / os
.DS_Store
Thumbs.db
.vscode/*
!.vscode/extensions.json
.idea/
