---
import { url } from '../lib/url';
import { SITE } from '../consts';
const year = new Date().getFullYear();
---
<footer class="site-footer">
  <div class="wrap">
    <div class="window window-shadow">
      <div class="title-bar title-bar--inactive">
        <span class="close-box" aria-hidden="true"></span>
        <span class="title">Credits</span>
        <span class="zoom-box" aria-hidden="true"></span>
      </div>
      <div class="footer-grid">
        <div>
          {SITE.title} — {SITE.author}. Built with {SITE.builtWith}.<br />
          No analytics, no cookies, no trackers.
        </div>
        <div>
          Desktop, fonts and controls after System 7, via
          <a href="https://github.com/sakofchit/system.css" rel="noopener noreferrer">system.css</a>
          (MIT); ascii art by
          <a href="https://ascii.rest/" rel="noopener noreferrer">ascii.rest</a>
          (MIT, <a href="https://github.com/bas3line" rel="noopener noreferrer">@bas3line</a>)
        </div>
        <div>
          <a href={url('/rss.xml')}>rss</a> · <a href={url('/sitemap-index.xml')}>sitemap</a> ·
          <a href={url('/colophon/')}>colophon</a><br />
          © {year}
        </div>
      </div>
    </div>
  </div>
</footer>
