---
import type { Note } from '../lib/site';
import { formatDate, minutes } from '../lib/site';

interface Props { note: Note; showGlyph?: boolean; }
const { note, showGlyph = true } = Astro.props;
const { title, description, pubDate, tags, ascii } = note.data;
---
<li class="note-item">
  <time datetime={pubDate.toISOString()}>{formatDate(pubDate)}</time>
  <div>
    <h3><a href={`/notes/${note.id}/`}>{title}</a></h3>
    <p class="desc">{description}</p>
    <div class="meta">
      <span class="glyph" aria-hidden="true">
        {showGlyph ? `▚ ${ascii.piece}` : ''}
      </span>
      <span>{minutes(note)} min</span>
      {tags.length > 0 && (
        <span class="tags">
          {tags.map((tag) => <a class="tag" href={`/tags/${tag}/`}>{tag}</a>)}
        </span>
      )}
    </div>
  </div>
</li>
