---
/**
 * <NoteItem> — one row of a Finder list view: a document icon, the note's
 * name (and its one-line description, which a Finder would put in the
 * comments column), then tags, date and reading time.
 */
import { url } from '../lib/url';
import type { Note } from '../lib/site';
import { formatDate, minutes } from '../lib/site';

interface Props { note: Note; showGlyph?: boolean; }
const { note } = Astro.props;
const { title, description, pubDate, tags } = note.data;
---
<li class="finder-row">
  <span class="finder-name">
    <span class="finder-name-main">
      <h3><a href={url(`/notes/${note.id}/`)}>{title}</a></h3>
      <p class="finder-desc">{description}</p>
    </span>
  </span>
  <span class="finder-tags tags">
    {tags.map((tag) => <a class="tag" href={url(`/tags/${tag}/`)}>{tag}</a>)}
  </span>
  <time class="finder-time" datetime={pubDate.toISOString()}>{formatDate(pubDate)}</time>
  <span class="finder-min">{minutes(note)} min</span>
</li>
