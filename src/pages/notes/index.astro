---
import BaseLayout from '../../layouts/BaseLayout.astro';
import NoteItem from '../../components/NoteItem.astro';
import { getNotes, tagIndex } from '../../lib/site';

const notes = await getNotes();
const tags = tagIndex(notes);
---
<BaseLayout title="Notes" description={`All ${notes.length} notes, newest first.`}>
  <h1>notes</h1>
  <p class="lede">
    {notes.length} entries. Everything here is something that went wrong first, or a thing I
    assumed and then checked. Newest first.
  </p>
  <ul class="note-list">
    {notes.map((note) => <NoteItem note={note} />)}
  </ul>

  <h2 class="no-hash">by tag</h2>
  <ul class="tag-cloud">
    {[...tags].map(([tag, list]) => (
      <li>
        <a class="tag" href={`/tags/${tag}/`}>{tag}</a>{' '}
        <span class="count">{list.length}</span>
      </li>
    ))}
  </ul>
</BaseLayout>
