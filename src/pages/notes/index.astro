---
import { url } from '../../lib/url';
import BaseLayout from '../../layouts/BaseLayout.astro';
import NoteItem from '../../components/NoteItem.astro';
import { getNotes, tagIndex } from '../../lib/site';

const notes = await getNotes();
const tags = tagIndex(notes);
---
<BaseLayout title="Notes" description={`All ${notes.length} notes, newest first.`}>
  <div class="window window-shadow">
    <div class="title-bar title-bar--active">
      <span class="close-box" aria-hidden="true"></span>
      <h1 class="title">Notes — {notes.length} items</h1>
      <span class="zoom-box" aria-hidden="true"></span>
    </div>
    <div class="window-body">
      <p class="lede">
        Everything here is something that went wrong first, or a thing I assumed and then
        checked. Newest first.
      </p>

      <div class="finder-head" aria-hidden="true">
        <span>Name</span><span>Tags</span><span>Date</span><span>Time</span>
      </div>
      <ul class="finder-list">
        {notes.map((note) => <NoteItem note={note} />)}
      </ul>
    </div>
  </div>

  <div class="window window-shadow" style="margin-top: 1.5rem;">
    <div class="title-bar title-bar--inactive">
      <span class="close-box" aria-hidden="true"></span>
      <span class="title">Tags</span>
      <span class="zoom-box" aria-hidden="true"></span>
    </div>
    <div class="window-body">
      <h2 class="rail-title">by tag</h2>
      <ul class="tag-cloud">
        {[...tags].map(([tag, list]) => (
          <li>
            <a class="tag" href={url(`/tags/${tag}/`)}>{tag}</a>{' '}
            <span class="count">{list.length}</span>
          </li>
        ))}
      </ul>
    </div>
  </div>
</BaseLayout>
