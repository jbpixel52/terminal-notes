---
import { render } from 'astro:content';
import PostLayout from '../../layouts/PostLayout.astro';
import { getNotes, type Note } from '../../lib/site';

export async function getStaticPaths() {
  const notes = await getNotes();
  return notes.map((note, i) => ({
    params: { slug: note.id },
    props: {
      note,
      // Newer note on the left, older on the right — the list is newest first.
      prev: notes[i + 1] ?? null,
      next: notes[i - 1] ?? null,
    },
  }));
}

interface Props { note: Note; prev: Note | null; next: Note | null; }
const { note, prev, next } = Astro.props;
const { Content } = await render(note);
---
<PostLayout note={note} prev={prev} next={next}>
  <Content />
</PostLayout>
