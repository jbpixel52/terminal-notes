---
import BaseLayout from '../layouts/BaseLayout.astro';
import NoteItem from '../components/NoteItem.astro';
import Ascii from '../components/Ascii.astro';
import { getNotes, tagIndex } from '../lib/site';
import { SITE } from '../consts';

const notes = await getNotes();
const tags = tagIndex(notes);
const recent = notes.slice(0, 6);
const pieces = new Set(notes.map((n) => n.data.ascii.piece));
---
<BaseLayout>
  <section class="hero">
    <h1 class="sr-only">{SITE.title} — {SITE.tagline}</h1>
    <div class="prompt" aria-hidden="true">~/notes $ ls -1 --recent</div>
    <div class="bare-art">
      <Ascii
        piece="big-text"
        options={{ text: 'notes' }}
        framed={false}
        label={`${SITE.title}, in big ascii letters`}
      />
    </div>
    <p class="lede">{SITE.description}</p>
    <ul class="stat-row">
      <li><b>{notes.length}</b><span>notes</span></li>
      <li><b>{tags.size}</b><span>tags</span></li>
      <li><b>{pieces.size}</b><span>ascii pieces</span></li>
    </ul>
  </section>

  <h2 class="no-hash">latest</h2>
  <ul class="note-list">
    {recent.map((note) => <NoteItem note={note} />)}
  </ul>
  <p><a href="/notes/">all {notes.length} notes →</a></p>

  <h2 class="no-hash">tags</h2>
  <ul class="tag-cloud">
    {[...tags].map(([tag, list]) => (
      <li>
        <a class="tag" href={`/tags/${tag}/`}>{tag}</a>{' '}
        <span class="count">{list.length}</span>
      </li>
    ))}
  </ul>
</BaseLayout>
