---
import { url } from '../lib/url';
import BaseLayout from '../layouts/BaseLayout.astro';
import Ascii from '../components/Ascii.astro';
import { getNotes } from '../lib/site';

const notes = await getNotes();
const suggestions = notes.slice(0, 3);
---
<BaseLayout title="404" description="That path is not in this notebook.">
  <h1>404 — no such note</h1>
  <Ascii piece="not-found" caption="the path you asked for is not here" />
  <p class="lede">
    Nothing lives at <code>{Astro.url.pathname}</code>. It may have been renamed, or it may
    never have existed.
  </p>
  <h2 class="no-hash">try instead</h2>
  <ul>
    <li><a href={url('/notes/')}>all notes</a></li>
    <li><a href={url('/tags/')}>tags</a></li>
    {suggestions.map((n) => <li><a href={url(`/notes/${n.id}/`)}>{n.data.title}</a></li>)}
  </ul>
</BaseLayout>
