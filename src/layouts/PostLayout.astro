---
import { url } from '../lib/url';
import BaseLayout from './BaseLayout.astro';
import Art from '../components/Art.astro';
import Ascii from '../components/Ascii.astro';
import { getSource } from '../art/sources';
import { formatDate, minutes, type Note } from '../lib/site';

interface Props {
  note: Note;
  prev?: Note | null;
  next?: Note | null;
  headings?: { depth: number; slug: string; text: string }[];
}
const { note, prev = null, next = null, headings = [] } = Astro.props;
const { title, description, pubDate, updatedDate, tags, ascii } = note.data;

// the rail's table of contents: the note's own top-level sections
const sections = headings.filter((h) => h.depth === 2);

// The picture hangs on the desktop now rather than in the note, so its credit
// has to live where a reader can find it: read the piece's name the way <Art>
// does, and the photograph's origin from the generated credit table.
const pieceModules = import.meta.glob('../art/pieces/*.js');
let picture: { name: string; note: string; source: ReturnType<typeof getSource> } | null = null;
if (ascii.art) {
  const mod = (await pieceModules[`../art/pieces/${ascii.art}.js`]()) as {
    meta: { name: string; note: string };
  };
  // the same fallback the figure used: the frontmatter's caption, else the
  // piece's own note about the photograph it was decoded from
  picture = { name: mod.meta.name, note: ascii.caption ?? mod.meta.note, source: getSource(ascii.art) };
}
---
<BaseLayout title={title} description={description}>
  {
    (ascii.art || ascii.piece) && (
      <div class="desk-art" aria-hidden="true">
        {ascii.art ? (
          <Art slug={ascii.art} framed={false} label={`ascii art for “${title}”`} />
        ) : (
          <Ascii
            piece={ascii.piece!}
            options={ascii.options}
            fps={ascii.fps}
            mono={ascii.mono}
            framed={false}
            label={`ascii art for “${title}”`}
          />
        )}
      </div>
    )
  }
  <article>
    <div class="note-desktop">
      <div class="window window-shadow note-shell">
        <div class="title-bar title-bar--active">
          <a
            class="close-box"
            href={url('/notes/')}
            aria-label="Close this note and go back to all notes"
          ></a>
          <span class="title">{title}</span>
          <span class="zoom-box" aria-hidden="true"></span>
        </div>
        <div class="window-body">
          <header class="post-header">
            <h1>{title}</h1>
            <div class="meta">
              <time datetime={pubDate.toISOString()}>{formatDate(pubDate)}</time>
              <span>{minutes(note)} min read</span>
              {updatedDate && <span>updated {formatDate(updatedDate)}</span>}
            </div>
            <p class="lede">{description}</p>
          </header>

          <div class="prose">
            <slot />
          </div>

          <footer class="post-footer">
            <p>
              Filed under{' '}
              {tags.map((tag, i) => (
                <span>
                  <a class="tag" href={url(`/tags/${tag}/`)}>{tag}</a>
                  {i < tags.length - 1 ? ', ' : ''}
                </span>
              ))}
              . <a href={url('/notes/')}>All notes</a>.
            </p>
            {picture && (
              <p class="post-credit">
                The picture on the desktop is <span class="piece-name">{picture.name}</span>
                {picture.note ? ` — ${picture.note}` : ''}
                {picture.source ? (
                  <>
                    {' · '}
                    <a
                      href={picture.source.page}
                      rel="noopener noreferrer"
                      title={`wallhaven ${picture.source.id} · "${picture.source.query}"`}
                    >
                      source image ↗
                    </a>
                  </>
                ) : null}
              </p>
            )}
            {!picture && ascii.piece && (
              <p class="post-credit">
                The picture on the desktop is <span class="piece-name">{ascii.piece}</span> —{' '}
                <a href={`https://ascii.rest/${ascii.piece}/`} rel="noopener noreferrer">
                  ascii.rest
                </a>
                .
              </p>
            )}
          </footer>
        </div>
      </div>

      <aside class="window window-shadow info-window" aria-label="About this note">
        <div class="title-bar title-bar--inactive">
          <span class="close-box" aria-hidden="true"></span>
          <span class="title">Info</span>
          <span class="zoom-box" aria-hidden="true"></span>
        </div>
        <div class="window-body">
          <div class="note-rail">
            {sections.length > 1 && (
              <nav class="rail-block">
                <h2 class="rail-title">on this page</h2>
                <ol class="rail-toc">
                  {sections.map((h) => <li><a href={`#${h.slug}`}>{h.text}</a></li>)}
                </ol>
              </nav>
            )}

            <div class="rail-block">
              <h2 class="rail-title">meta</h2>
              <dl class="rail-meta">
                <dt>published</dt>
                <dd><time datetime={pubDate.toISOString()}>{formatDate(pubDate)}</time></dd>
                <dt>reading</dt>
                <dd>{minutes(note)} min</dd>
                <dt>tags</dt>
                <dd class="rail-tags">
                  {tags.map((tag) => <a class="tag" href={url(`/tags/${tag}/`)}>{tag}</a>)}
                </dd>
              </dl>
            </div>

            <nav class="rail-block">
              <h2 class="rail-title">nearby</h2>
              <ul class="rail-links">
                {prev && <li><a href={url(`/notes/${prev.id}/`)}>← {prev.data.title}</a></li>}
                {next && <li><a href={url(`/notes/${next.id}/`)}>{next.data.title} →</a></li>}
                <li><a href={url('/notes/')}>all notes</a></li>
              </ul>
            </nav>
          </div>
        </div>
      </aside>
    </div>
  </article>
</BaseLayout>
